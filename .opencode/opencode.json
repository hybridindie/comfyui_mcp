{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "rm *": "ask"
    },
    "websearch": "allow",
    "webfetch": "allow"
  },
  "instructions": [
    "AGENTS.md",
    "my-workflows.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "graphify": {
      "type": "local",
      "command": [
        "graphify-mcp",
        "graphify-out/graph.json",
        "--transport",
        "stdio"
      ],
      "enabled": true
    }
  },
  "watcher": {
    "ignore": [
      "graphify-out/**",
      ".venv/**",
      ".mypy_cache/**",
      ".ruff_cache/**",
      ".pytest_cache/**",
      ".benchmarks/**",
      "uv.lock",
      "dist/**",
      "logs/**",
      ".obsidian/**"
    ]
  },
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  }
}
