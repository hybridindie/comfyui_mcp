{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "rm *": "ask"
    },
    "websearch": "allow",
    "webfetch": "allow"
  },
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/security.md",
    ".opencode/rules/architecture.md",
    ".opencode/rules/tools.md",
    ".opencode/rules/testing.md",
    ".opencode/rules/workflow.md",
    ".opencode/rules/enforcement.md",
    ".opencode/rules/graphify.md",
    ".wiki-overlay.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "graphify": {
      "type": "local",
      "command": [
        "graphify-mcp",
        "graphify-out/graph.json",
        "--transport",
        "stdio"
      ],
      "enabled": true
    }
  },
  "watcher": {
    "ignore": [
      "graphify-out/**",
      ".venv/**",
      ".mypy_cache/**",
      ".ruff_cache/**",
      ".pytest_cache/**",
      ".benchmarks/**",
      "uv.lock",
      "dist/**",
      "logs/**",
      "evidence/raw/**",
      ".obsidian/**"
    ]
  },
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "references": {
    "wiki-fabric": {
      "path": "~/Development/wiki-fabric",
      "description": "Global knowledge fabric (evidence-first wiki + cross-project promotion)"
    }
  },
  "skills": {
    "paths": [
      "~/Development/wiki-fabric/system/skills"
    ]
  }
}
