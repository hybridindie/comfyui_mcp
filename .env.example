# opencode harness (optional opt-ins)
#
# Built-in websearch (Exa-hosted, no API key needed). Off by default; uncomment
# and export before launching opencode to give the agent web search alongside
# Context7 (which is library-docs-only). Useful for ComfyUI API quirks, error
# messages, and node-package docs not in any library's docs.
#   source .env  (or: set -a; . ./.env; set +a)
#   opencode
# OPENCODE_ENABLE_EXA=1

# Experimental LSP tool — go-to-def / find-references / hover via configured LSP
# servers. Opt-in only; it's experimental and not required for any workflow.
# OPENCODE_EXPERIMENTAL_LSP_TOOL=true

# graphify LLM backend (used by scripts/graphify.sh for community labeling).
# The default backend is the MLflow AI Gateway (OpenAI-compatible); local
# ollama is the fallback. detect_backend() checks openai BEFORE ollama, so the
# gateway wins whenever its key is present (an incidental OLLAMA_BASE_URL never
# shadows it). Uncomment and fill to enable labeling via the gateway.

# Primary: MLflow AI Gateway (OpenAI-compatible /deployments route)
# OPENAI_BASE_URL=https://mlflow.johndstudios.net/gateway/mlflow/v1  # base ends at /v1
# OPENAI_API_KEY=gateway                    # placeholder — the gateway needs no secret
# GRAPHIFY_OPENAI_MODEL=gpt-oss-120b-cloud  # or glm-5.2-cloud
# GRAPHIFY_API_TIMEOUT=600

# Fallback: local ollama (used only if the OPENAI_* block is removed, or with
# an explicit `--backend ollama`)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3-coder-next:cloud
# OLLAMA_API_KEY=ollama
# GRAPHIFY_OLLAMA_KEEP_ALIVE=30m
